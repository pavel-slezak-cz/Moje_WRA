generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ── Scale type enum ──

enum ScaleType {
  LIKERT_5
  LIKERT_7
  TEXT
  YES_NO
}

enum ProjectRole {
  OWNER
  ADMIN
  PARTICIPANT
}

// ── Core user model ──

model User {
  id           Int                @id @default(autoincrement())
  email        String             @unique
  passwordHash String             @map("password_hash")
  name         String
  createdAt    DateTime           @default(now()) @map("created_at")

  legacyResponses     LegacyResponse[]
  instrumentResponses InstrumentResponse[]
  ownedProjects       Project[]              @relation("ProjectOwner")
  participations      ProjectParticipant[]

  @@map("users")
}

// ── Legacy models (backward compat, deprecated) ──

model Questionnaire {
  id          Int              @id @default(autoincrement())
  title       String           @unique
  description String?
  questions   Json
  createdAt   DateTime         @default(now()) @map("created_at")

  responses LegacyResponse[]

  @@map("questionnaires")
}

model LegacyResponse {
  id               Int           @id @default(autoincrement())
  userId           Int           @map("user_id")
  questionnaireId  Int           @map("questionnaire_id")
  answers          Json
  createdAt        DateTime      @default(now()) @map("created_at")

  user             User          @relation(fields: [userId], references: [id])
  questionnaire    Questionnaire @relation(fields: [questionnaireId], references: [id])

  @@map("legacy_responses")
}

// ── Psychometric instrument models ──

model Instrument {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  description String?
  createdAt   DateTime            @default(now()) @map("created_at")

  versions InstrumentVersion[]

  @@map("instruments")
}

model InstrumentVersion {
  id            Int      @id @default(autoincrement())
  instrumentId  Int      @map("instrument_id")
  versionNumber String   @map("version_number")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  instrument Instrument           @relation(fields: [instrumentId], references: [id])
  items      Item[]
  responses  InstrumentResponse[]
  projects   Project[]

  @@unique([instrumentId, versionNumber])
  @@map("instrument_versions")
}

model Construct {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  items Item[]

  @@map("constructs")
}

model Item {
  id                  Int              @id @default(autoincrement())
  instrumentVersionId Int              @map("instrument_version_id")
  constructId         Int              @map("construct_id")
  text                String           @db.Text
  scaleType           ScaleType        @default(LIKERT_5) @map("scale_type")
  reverseScored       Boolean          @default(false) @map("reverse_scored")
  position            Int

  instrumentVersion InstrumentVersion @relation(fields: [instrumentVersionId], references: [id])
  construct         Construct         @relation(fields: [constructId], references: [id])
  responseItems     ResponseItem[]

  @@map("items")
}

model InstrumentResponse {
  id                  Int              @id @default(autoincrement())
  userId              Int              @map("user_id")
  instrumentVersionId Int              @map("instrument_version_id")
  projectId           Int              @map("project_id")
  createdAt           DateTime         @default(now()) @map("created_at")

  user              User              @relation(fields: [userId], references: [id])
  instrumentVersion InstrumentVersion @relation(fields: [instrumentVersionId], references: [id])
  project           Project           @relation(fields: [projectId], references: [id])
  items             ResponseItem[]

  @@map("instrument_responses")
}

// ── Project models ──

model Project {
  id                  Int              @id @default(autoincrement())
  name                String           @unique
  description         String?
  ownerUserId         Int              @map("owner_user_id")
  instrumentVersionId Int              @map("instrument_version_id")
  createdAt           DateTime         @default(now()) @map("created_at")

  owner             User                @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  instrumentVersion InstrumentVersion   @relation(fields: [instrumentVersionId], references: [id])
  participants      ProjectParticipant[]
  responses         InstrumentResponse[]

  @@map("projects")
}

model ProjectParticipant {
  id        Int         @id @default(autoincrement())
  projectId Int         @map("project_id")
  userId    Int         @map("user_id")
  role      ProjectRole @default(PARTICIPANT)
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_participants")
}

model ResponseItem {
  id         Int @id @default(autoincrement())
  responseId Int @map("response_id")
  itemId     Int @map("item_id")
  value      Int

  response InstrumentResponse @relation(fields: [responseId], references: [id])
  item     Item               @relation(fields: [itemId], references: [id])

  @@unique([responseId, itemId])
  @@map("response_items")
}
